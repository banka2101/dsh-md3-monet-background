{
  "name": "@local/theme-background",
  "version": "1.1.1",
  "type": "module",
  "description": "Custom background image with a Material You color palette for the DSH Web GUI.",
  "keywords": ["dsh-plugin", "deepseek-harness", "wallpaper", "material-you"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banka2101/dsh-theme-background.git"
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENT_README.md",
    "docs/screenshots/*.png",
    "LICENSE",
    "LICENSE-MATERIAL-COLOR-UTILITIES",
    "build.mjs",
    "client.template.js",
    "vendor/mcu.inline.js",
    "vendor/static-specs.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
